# Copy these into your host's environment variables (Railway, Render, ...).
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=generate-a-long-random-string
DJANGO_ALLOWED_HOSTS=your-api.up.railway.app
CORS_ALLOWED_ORIGINS=https://your-portfolio.vercel.app
CSRF_TRUSTED_ORIGINS=https://your-api.up.railway.app
# Postgres connection string given by the host (keeps contact messages across deploys)
DATABASE_URL=postgresql://user:password@host:5432/dbname
