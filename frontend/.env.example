# Server-side calls (Next.js server components). Falls back to NEXT_PUBLIC_API_URL.
API_URL=http://127.0.0.1:8000/api/v1
# Browser calls (contact form). Must be reachable from the visitor's browser.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
# Public address of the site, used for the sitemap and absolute metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
